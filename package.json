{
  "name": "chatgpt-multitask",
  "version": "4.0.0",
  "description": "Cross-platform desktop application for official ChatGPT with native multi-tab functionality",
  "main": "dist/main/index.js",
  "author": "ChatGPT Multitask Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sufyanaser/ChatGPT-Multitask-.git"
  },
  "scripts": {
    "clean": "rimraf dist",
    "clean:all": "rimraf dist release",
    "build:tsc": "tsc",
    "build": "npm run clean && tsc && node scripts/copy-assets.js",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "npm run build && node scripts/run-tests.js",
    "start": "npm run build && electron .",
    "generate:icons": "node scripts/generate-icons.js",
    "pack:win": "npm run build && electron-builder --win --x64 --publish never",
    "pack:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "electron": "^34.5.8",
    "electron-builder": "^26.18.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  },
  "build": {
    "appId": "com.chatgpt.multitask",
    "productName": "ChatGPT Multitask",
    "copyright": "Copyright © 2026 ChatGPT Multitask Contributors",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "ChatGPT-Multitask-Windows-x64-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ChatGPT Multitask",
      "uninstallDisplayName": "ChatGPT Multitask",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "ChatGPT-Multitask-macOS-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true,
      "identity": null
    },
    "dmg": {
      "artifactName": "ChatGPT-Multitask-macOS-${arch}.${ext}",
      "sign": false
    },
    "publish": {
      "provider": "github",
      "owner": "sufyanaser",
      "repo": "ChatGPT-Multitask-"
    }
  }
}
